generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  hostedRooms Room[]        @relation("RoomHost")
  memberships RoomMember[]
}

model Room {
  id        String   @id @default(uuid())
  hostId    String
  host      User     @relation("RoomHost", fields: [hostId], references: [id])
  name String

  status        VideoStatus @default(NOT_PLAYING)
  mediaId      String?
  seekPosition Int          @default(0)

  createdAt DateTime @default(now())

  password String 

  members RoomMember[]
  media   Media[]
}

model RoomMember {
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([roomId, userId])
}

model Media {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])

  filename  String
  objectKey String

  createdAt DateTime @default(now())
}

enum VideoStatus {
  PLAYING
  NOT_PLAYING
}